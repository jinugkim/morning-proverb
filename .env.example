# Kakao Developers REST API key (required for token issuance and local sending)
KAKAO_REST_API_KEY=

# Set only when Client Secret is enabled in Kakao Developers
KAKAO_CLIENT_SECRET=

# Required by main.py for local proverb generation and delivery
GEMINI_API_KEY=
KAKAO_REFRESH_TOKEN_ME=
GITHUB_REPOSITORY=jinugkim/morning-proverb

# Optional; defaults to http://127.0.0.1:5001/oauth
# KAKAO_REDIRECT_URI=http://127.0.0.1:5001/oauth
